# ── Required in production ────────────────────────────────────────────────
# Internal integration token from https://www.notion.so/profile/integrations
# The integration must be granted access to the " 2026 GRANTSAPPS" page
# (which contains the tracker and all four registries).
# Leave unset to run in DEMO MODE with bundled fixture data.
NOTION_TOKEN=

# Random 32+ char string. `openssl rand -hex 32`
SESSION_SECRET=

# Public URL of the deployed app (used in magic-link emails).
APP_URL=http://localhost:3000

# ── Email (magic links) ───────────────────────────────────────────────────
# https://resend.com API key. If unset, sign-in links are printed to the
# server console instead of emailed (fine for local dev).
RESEND_API_KEY=
EMAIL_FROM="Measurement Ally Grants <grants@measurementally.com>"

# ── Access control ────────────────────────────────────────────────────────
# Optional JSON that extends/overrides the built-in allowlist, e.g.
# {"newperson@namifc.org":"namifc","someone@arkbuilders.org":"arkbuilders"}
# Scopes: "namifc" | "arkbuilders" | "all" (Erica only)
ALLOWLIST_JSON=

# ── Notion data source IDs (defaults are baked in; override only if the
#    databases are ever recreated) ──────────────────────────────────────────
# Grant Submissions Tracker
DS_TRACKER=f7f74e81-1f18-4cf2-a502-3f49d2a24917
# Org Facts Registry
DS_ORG_FACTS=65057ab4-1ddd-45ae-bb46-a5fd39c48abb
# Document Registry
DS_DOCS=6895feaf-90f8-4967-a874-5f3591f1ef57
# Standard Language Library
DS_LANGUAGE=d235f20c-26e1-4703-8de3-d49d4c58d7df
# Application Field Log
DS_FIELD_LOG=a7dad9d8-c215-4cd6-b902-7af8742615fd
